<!--
  The six pages that are meant to be found.

  Deliberately short and hand-maintained. A generated sitemap of every route
  would list thirty authenticated screens that return a login form, which
  teaches a crawler that this site is thirty copies of the same page and is
  worse than having no sitemap at all.

  URLs are relative on purpose: this application is served under the platform's
  own domain and under each reseller's, and a sitemap hard-coding one of them
  would point every deployment at somebody else's site.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/pricing</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/trust</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>/dpa</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
