# Copy to .env for standalone (non-Docker) runs. Under docker-compose these
# are already wired from the repo root .env -- see docker-compose.yml.

PORT=4001

# Must exactly match Django's QR_PROVIDER_API_KEY / QR_PROVIDER_WEBHOOK_SECRET.
QR_PROVIDER_API_KEY=
QR_PROVIDER_WEBHOOK_SECRET=

QR_BRIDGE_DATA_DIR=./data
# How long a generated QR stays scannable. Clamped to 30-3600; anything
# outside that range is corrected to 120 (see src/config.ts).
WHATSAPP_QR_SESSION_TTL_SECONDS=120
QR_BRIDGE_LOG_LEVEL=info
# Baileys' own logger, kept separate from the one above. At debug/trace it
# prints Signal pre-keys and session state -- the material that would let
# somebody impersonate a connected number -- so raising QR_BRIDGE_LOG_LEVEL to
# debug an unrelated problem must not drag those into the logs. Only turn this
# up temporarily, and never on a host whose logs are shipped somewhere.
QR_BRIDGE_BAILEYS_LOG_LEVEL=warn

# Which wire shape a button message is relayed in. Leave UNSET.
#
# Unset means `buttons_legacy`, which Baileys 6.7.24 flattens to plain text
# before it reaches WhatsApp -- so the body always arrives readable. Django is
# the real gate anyway: WhatsAppQRBridgeProvider.supports_interactive_buttons is
# False, so it renders buttons as numbered text and never asks this bridge for
# an interactive message at all.
#
# `native_flow_helper` is the only value that produces genuinely tappable
# buttons, via the biz/interactive/native_flow + bot stanza nodes the official
# client emits (src/nativeFlow.ts). Every other value is a hand-built payload
# that has been measured failing on a real handset.
#
# DO NOT set this because it looks like the feature you want. Set it only after
# `npx tsx qr-button-test.ts <recipient> 09_helper_engine` has put two tappable
# buttons on an actual phone and `--replies` has shown the tapped id coming
# back. An ack, a message id and a delivery receipt are all returned for
# messages that render nothing.
# QR_BRIDGE_INTERACTIVE_FORMAT=native_flow_helper
