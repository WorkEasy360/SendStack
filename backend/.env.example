# Copy to .env and fill in real values. Never commit the real .env file.

# config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=multisender
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Fernet key used to encrypt stored WhatsApp provider access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Optional: overrides SECRET_KEY for JWT signing if set.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sendstack.local
FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_AUTH=10/min

# --- Campaign sending pace and account assignment ---------------------------
# Every outgoing campaign message waits its own freshly generated random
# delay d, with 0 < d <= max. Both bounds default to
# CAMPAIGN_SEND_INTERVAL_SECONDS, which makes min == max and reproduces the
# fixed interval campaigns used before per-message delays existed. Set them
# apart (e.g. 1 and 5) to actually randomise the pace. A campaign can
# override either bound; these are only the fallback.
CAMPAIGN_SEND_INTERVAL_SECONDS=1
# CAMPAIGN_MIN_DELAY_SECONDS=1
# CAMPAIGN_MAX_DELAY_SECONDS=5

# Assignment mode for campaigns created without one. MANUAL sends the whole
# campaign from the single account it was created with; AUTO spreads
# recipients across every connected account in the tenant.
CAMPAIGN_ACCOUNT_ASSIGNMENT_MODE=MANUAL

# --- Sender health -------------------------------------------------------
# Ceilings for one WhatsApp number. A message over the limit is held and sent
# when the window reopens, never dropped. 0 means no limit, which is how every
# deployment behaved before these existed. A single number can be given its
# own limits from the Devices page; where both exist, the lower one applies.
WHATSAPP_DAILY_SEND_LIMIT=1000
WHATSAPP_HOURLY_SEND_LIMIT=200

# Warmup ramp for a newly connected QR number: its allowance on day one, day
# two, and so on. Once the ladder runs out the number gets the normal daily
# limit. Measured from the number's first send, so numbers with existing
# history are already past it. Cloud API numbers never ramp -- Meta meters
# those itself.
WHATSAPP_WARMUP_ENABLED=true
WHATSAPP_WARMUP_LADDER=50,100,250,500,750

# A number that starts failing at an unusual rate stops sending by itself,
# because pushing a number WhatsApp has begun refusing is how a temporary
# block becomes a permanent one. The minimum sample stops two failures on a
# quiet account from pausing it.
WHATSAPP_AUTO_PAUSE_ENABLED=true
WHATSAPP_FAILURE_WINDOW_MINUTES=30
WHATSAPP_FAILURE_SAMPLE_MIN=10
WHATSAPP_FAILURE_RATE_THRESHOLD=0.5
WHATSAPP_AUTO_PAUSE_MINUTES=60

# Longest a single message may be held by the send gate (quiet hours, a send
# limit, a paused number) before it is given up on and reported as skipped.
MESSAGE_MAX_HOLD_SECONDS=172800

# --- AI agents ---------------------------------------------------------
# Deployment-wide model key, shared by the WhatsApp AI agent and the calling
# agent. A tenant may store their own instead (encrypted, set from the AI
# Agent / Calling Agent pages); with neither, both agents stay silent.
#
# Which vendor the key is for is chosen per tenant on those same pages:
# Anthropic (an sk-ant- key, models like claude-sonnet-5), OpenAI (an sk- key,
# models like gpt-4o-mini), OpenRouter (an sk-or- key, models written
# vendor/model), or Custom (any OpenAI-compatible endpoint -- a self-host,
# Azure, Groq -- with its own base URL set on the same page). One key here has
# to match whatever the tenants are set to, so a multi-tenant install usually
# leaves this blank and lets each tenant bring their own.
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30

# --- OpenAI ------------------------------------------------------------
# Read only by tenants whose provider is set to OpenAI, and only where that
# tenant stored no key of their own. A tenant key always wins.
#
# For a single-tenant install these three are the whole configuration: set
# them, pick OpenAI on the AI Agent page, and leave that page's key and model
# boxes blank. The model in use is then whatever OPENAI_MODEL says.
#
# OPENAI_BASE_URL points at OpenAI itself; change it for Azure OpenAI, a proxy
# or an internal gateway speaking the same API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Semantic retrieval (embeddings) -----------------------------------
# Off by default; the knowledge base works fully without it, using lexical
# retrieval. Turned on, chunks are embedded on upload and questions at ask
# time, and the vector score is blended with the lexical one rather than
# replacing it -- so exact product codes stay reliable while a question that
# shares no words with its answer can still find it.
#
# Needs an OpenAI-shaped /embeddings endpoint: OPENAI_API_KEY above, or a
# tenant on OpenAI/OpenRouter/Custom using their own. Changing the model
# invalidates every stored vector -- re-index afterwards.
AI_EMBEDDINGS_ENABLED=false
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_WEIGHT=0.5
AI_EMBEDDING_BATCH_SIZE=64

# --- Knowledge-base-only answering -------------------------------------
# On: the agent answers factual questions from the tenant's own documents and
# from nothing else. A question the documents do not cover is refused in
# plain words rather than answered from the model's general knowledge.
#
# This is a deployment-wide policy, not a per-tenant preference: it overrides
# each tenant's own "answer from knowledge only" switch, and it closes the
# hole where turning tools on removed the relevance gate and left the model
# free to answer from its own weights.
AI_KNOWLEDGE_ONLY=true

# How closely retrieved material must match the question (0-1) before the
# model is called at all. Below this the answer is "not in the knowledge
# base" and no request is made -- which is the anti-hallucination path and
# the cost-control path at once.
#
# Raise it if the agent answers from loosely related documents; lower it if
# it refuses questions the documents do plainly cover. A tenant may set a
# higher bar of their own, never a lower one.
AI_KNOWLEDGE_MIN_RELEVANCE=0.15

# --- AI calling agent (Twilio Programmable Voice) ----------------------
# Twilio Account SID, Auth Token and the "call from" number are per tenant
# and stored encrypted -- set those on the Calling Agent page, not here.
#
# The one setting a call cannot be placed without: the origin Twilio posts
# its webhooks back to during a live call. Running Django on :8000 directly,
# point a tunnel at that port:
#   cloudflared tunnel --url http://localhost:8000    (or: ngrok http 8000)
VOICE_PUBLIC_BASE_URL=
# Twilio signs every webhook. False accepts anything that knows a call token
# -- only ever for local development, where the URL Twilio signed and the one
# this process reconstructs can legitimately differ.
VOICE_VALIDATE_SIGNATURES=true
# How long one turn may spend thinking. Twilio fails a call whose webhook has
# not answered in 15 seconds, so this leaves room for retrieval, tool
# round-trips and HTTP overhead.
VOICE_TURN_BUDGET_SECONDS=11
VOICE_REQUEST_TIMEOUT_SECONDS=15
VOICE_RING_TIMEOUT_SECONDS=40
VOICE_TRANSFER_TIMEOUT_SECONDS=30
# Gap between calls in a batch. Carriers rate-limit concurrent originations,
# and a burst from one number is what their spam filtering looks for.
VOICE_CALL_INTERVAL_SECONDS=5
# A call the carrier has stopped reporting on is closed out after this long.
VOICE_STALE_CALL_SECONDS=1800
