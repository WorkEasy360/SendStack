# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the real .env file.

SECRET_KEY=
ALLOWED_HOSTS=your-domain.com

DB_NAME=multisender
DB_USER=multisender
DB_PASSWORD=

# Redis password. Required: docker-compose starts Redis with --requirepass and
# refuses to come up without this. Redis holds the cache, the rate-limit and
# failed-login counters and every queued Celery task, and it is no longer
# published on a host port -- this is the second lock on the same door.
#
# The application splices this into the Redis URL itself (and URL-quotes it),
# so REDIS_URL stays a plain host/db and the secret lives in exactly one place.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- Transport security -------------------------------------------------
# Production redirects every plain-HTTP request to HTTPS by default, and this
# is the switch that turns that off. Set it to false ONLY while nothing in
# front of nginx terminates TLS: with no certificate, every request redirects
# to a port nothing is listening on and the site is unreachable. Put a
# certificate in front (a managed load balancer, Cloudflare, or nginx +
# certbot), then delete this line.
SECURE_SSL_REDIRECT=true

# Origins allowed to make an unsafe cross-origin POST -- the Django admin
# login behind a proxy is the one that matters. Defaults to https:// of each
# ALLOWED_HOSTS entry, so this only needs setting when the public origin
# differs from the host header.
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- TLS certificates (docker-compose.prod.yml) --------------------------
# Read by nginx/docker-entrypoint.sh, not by Django.
#
# The single switch that decides how nginx serves. Left empty, nginx serves
# plain HTTP on :80 -- which is the correct and expected state before a
# certificate has ever been issued, and the state a deployment stays in if
# something else (Cloudflare, an Oracle load balancer) terminates TLS
# upstream. Set to the bare domain and, once a certificate for it exists on
# disk, the same image serves :443 and redirects :80 to it.
#
# Setting this does NOT issue anything by itself. Issuance is a deliberate
# one-off command -- see docs/DEPLOY.md -- because the ways it fails (DNS not
# propagated, port 80 closed in the security list) are the ways that burn
# Let's Encrypt's rate limit if retried in a loop.
#
# Set SECURE_SSL_REDIRECT=false above until this is working, then remove it.
DOMAIN=
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
# Used only by the manual issuance command in docs/DEPLOY.md.
CERTBOT_EMAIL=
# Host port for HTTPS. Change only if 443 is already taken on the VM.
HTTPS_PORT=443

# --- Request rate limits -------------------------------------------------
# THROTTLE_RATE_AUTH now actually applies to login, logout and password reset;
# it was configured before but nothing used it, so those endpoints ran on the
# looser anonymous rate. It is counted per client address, so a whole office
# behind one NAT shares one budget -- raise it if legitimate users on a shared
# egress address start seeing 429s at the start of the working day. The
# per-account lockout below is the control that does not care about addresses,
# and is the one doing the security work.
# THROTTLE_RATE_ANON=60/min
# THROTTLE_RATE_USER=300/min
# THROTTLE_RATE_AUTH=10/min

# --- Failed-login protection --------------------------------------------
# Attempts against a single account before it stops accepting them, and for
# how long. Counted per account rather than per client address, so rotating
# IPs does not reset it; the timer runs from the first failure, so a user who
# mistyped their password is never locked out for longer than this. Set
# AUTH_MAX_FAILED_ATTEMPTS=0 to switch the mechanism off.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900

# --- Django admin --------------------------------------------------------
# Where the admin is mounted, without a leading slash. Moving it off "admin/"
# is not a security control by itself, just one fewer path every scanner tries.
DJANGO_ADMIN_URL=admin/
# Optional comma-separated IP allowlist for the admin. Anything else gets a
# 404. Leave blank unless your operators have fixed addresses -- setting it
# wrong locks you out of your own admin. The per-account lockout and nginx's
# rate limit on /admin/ apply either way.
# ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11

# Fernet key used to encrypt stored WhatsApp provider access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_TOKEN_ENCRYPTION_KEY=

JWT_SECRET=
FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Publicly reachable URL of this backend (used to build the QR bridge's
# webhook callback URL). Under `docker compose up`, docker-compose.yml
# overrides this to the internal http://backend:8000 -- only used as
# written here when running Django outside Docker.
BACKEND_PUBLIC_URL=https://your-domain.com

# QR/device-linking bridge (qr-bridge/, a separate Node service) for
# "Normal WhatsApp" / "WhatsApp Business App" connections. Leave
# QR_PROVIDER_API_KEY/WEBHOOK_SECRET unset to disable QR connections (the
# wizard shows "QR provider is not configured" rather than faking one; the
# qr-bridge container will restart-loop harmlessly without blocking anything
# else). Under docker-compose, QR_PROVIDER_BASE_URL is fixed to the internal
# http://qr-bridge:4001 -- only set it here when running the bridge outside
# Docker. Both values must exactly match qr-bridge/.env's copies. See
# backend/apps/whatsapp/providers/qr_bridge.py for the full HTTP contract.
QR_PROVIDER_BASE_URL=
QR_PROVIDER_API_KEY=
QR_PROVIDER_WEBHOOK_SECRET=
# How long a generated QR code stays scannable before the account moves to
# EXPIRED and a new QR must be asked for. Clamped to 30-3600 seconds on both
# sides; anything outside that range is corrected to 120, because a larger
# value overflows the QR bridge's own timers and Date handling rather than
# meaning "never expire".
WHATSAPP_QR_SESSION_TTL_SECONDS=120

# --- Sender health -------------------------------------------------------
# Ceilings for one WhatsApp number. A message over the limit is held and sent
# when the window reopens, never dropped. 0 means no limit, which is how every
# deployment behaved before these existed. A single number can be given its
# own limits from the Devices page; where both exist, the lower one applies.
WHATSAPP_DAILY_SEND_LIMIT=1000
WHATSAPP_HOURLY_SEND_LIMIT=200

# Warmup ramp for a newly connected QR number: its allowance on day one, day
# two, and so on. Once the ladder runs out the number gets the normal daily
# limit. Measured from the number's first send, so numbers with existing
# history are already past it. Cloud API numbers never ramp -- Meta meters
# those itself.
WHATSAPP_WARMUP_ENABLED=true
WHATSAPP_WARMUP_LADDER=50,100,250,500,750

# A number that starts failing at an unusual rate stops sending by itself,
# because pushing a number WhatsApp has begun refusing is how a temporary
# block becomes a permanent one. The minimum sample stops two failures on a
# quiet account from pausing it.
WHATSAPP_AUTO_PAUSE_ENABLED=true
WHATSAPP_FAILURE_WINDOW_MINUTES=30
WHATSAPP_FAILURE_SAMPLE_MIN=10
WHATSAPP_FAILURE_RATE_THRESHOLD=0.5
WHATSAPP_AUTO_PAUSE_MINUTES=60

# Longest a single message may be held by the send gate (quiet hours, a send
# limit, a paused number) before it is given up on and reported as skipped.
MESSAGE_MAX_HOLD_SECONDS=172800

# Deployment-wide model key, used by both the WhatsApp AI agent and the
# calling agent when a tenant has not stored their own. With neither set, both
# agents simply stay silent. The vendor is chosen per tenant on the AI Agent /
# Calling Agent pages -- Anthropic (sk-ant-), OpenAI (sk-), OpenRouter
# (sk-or-), or Custom (any OpenAI-compatible endpoint, with its own base URL)
# -- so this key has to be for whichever they are set to.
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30

# --- OpenAI ------------------------------------------------------------
# Read only by tenants whose agent provider is set to "OpenAI", and only where
# that tenant has not stored a key of their own -- a tenant key always wins, so
# one customer can still bring their own account on a shared install.
#
# For a single-tenant deployment these three are the whole configuration:
# set them, choose OpenAI on the AI Agent page, and leave the key and model
# boxes there blank. The model in use is then whatever OPENAI_MODEL says, so
# changing model is an environment change and a worker restart rather than an
# edit in every tenant.
#
# OPENAI_BASE_URL points at OpenAI itself by default. Change it to reach Azure
# OpenAI, a proxy, or an internal gateway that speaks the same API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Semantic retrieval (embeddings) -----------------------------------
# Off by default, and the knowledge base is fully usable without it: retrieval
# is lexical (keyword overlap weighted by rarity) and needs no embedding calls,
# no vector database and no extra service.
#
# Turning it on adds a second opinion rather than replacing the first. Chunks
# are embedded on upload and questions at ask time, and the two scores are
# blended -- so an exact product code stays reliable while "how long do I have
# to send it back?" can still find a policy that only ever says "returns".
#
# It needs an OpenAI-shaped /embeddings endpoint: either OPENAI_API_KEY above,
# or a tenant whose own provider is OpenAI/OpenRouter/Custom. A tenant on
# Anthropic uses the deployment's OpenAI key for this, since Anthropic has no
# embeddings API.
#
# Costs: one embedding call per chunk at upload, one per question, and a vector
# row per chunk. Changing AI_EMBEDDING_MODEL invalidates every stored vector --
# re-index the documents afterwards, or retrieval quietly falls back to lexical
# for anything embedded with the old model.
AI_EMBEDDINGS_ENABLED=false
AI_EMBEDDING_MODEL=text-embedding-3-small
# How much of the final score the vector similarity is worth, 0-1. At 0.5 a
# chunk has to do well on both halves to win, which is the point of a hybrid.
AI_EMBEDDING_WEIGHT=0.5
AI_EMBEDDING_BATCH_SIZE=64

# --- Knowledge-base-only answering -------------------------------------
# On: the agent answers factual questions from the tenant's own documents and
# from nothing else. A question the documents do not cover is refused in plain
# words rather than answered from the model's general knowledge.
#
# Deployment-wide policy rather than a per-tenant preference: it overrides each
# tenant's own "answer from knowledge only" switch, and it closes the hole
# where turning tools on removed the relevance gate and left the model free to
# answer from its own weights.
AI_KNOWLEDGE_ONLY=true

# How closely retrieved material must match the question (0-1) before the model
# is called at all. Below this the answer is "not in the knowledge base" and no
# request is made -- the anti-hallucination path and the cost-control path at
# once. A tenant may set a higher bar of their own, never a lower one.
AI_KNOWLEDGE_MIN_RELEVANCE=0.15

# --- AI calling agent (Twilio Programmable Voice) ----------------------
# The Twilio Account SID, Auth Token and "call from" number are per tenant and
# stored encrypted -- set those on the Calling Agent page, not here.
#
# This is the one setting a call cannot be placed without: the origin Twilio
# posts its webhooks back to during a live call. It is deliberately separate
# from BACKEND_PUBLIC_URL, which under docker-compose is the internal
# http://backend:8000 -- a name only resolvable inside the Docker network and
# therefore unreachable by Twilio. In development this is a tunnel:
#   cloudflared tunnel --url http://localhost      (or: ngrok http 80)
# and in production it is the real public hostname, with TLS in front.
VOICE_PUBLIC_BASE_URL=
# Twilio signs every webhook. Turning this off accepts anything that knows a
# call token, so it is only ever off in local development where the URL Twilio
# signed and the URL this process reconstructs can legitimately differ.
VOICE_VALIDATE_SIGNATURES=true
# How long one turn of conversation may spend thinking. Twilio abandons a
# webhook that has not answered in 15 seconds and fails the call, so this has
# to leave room for retrieval, tool round-trips and HTTP overhead.
VOICE_TURN_BUDGET_SECONDS=11
VOICE_REQUEST_TIMEOUT_SECONDS=15
# How long the phone rings before giving up, and how long a transfer rings.
VOICE_RING_TIMEOUT_SECONDS=40
VOICE_TRANSFER_TIMEOUT_SECONDS=30
# Gap between calls in a batch. Carriers rate-limit concurrent originations,
# and a burst from one number is also what their spam filtering looks for.
VOICE_CALL_INTERVAL_SECONDS=5
# A call the carrier has stopped reporting on is closed out after this long.
VOICE_STALE_CALL_SECONDS=1800

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

# Port nginx listens on inside the host (change if 80 is already taken).
HTTP_PORT=80

# Gunicorn worker count defaults to 2*CPUs+1 based on what the container
# actually gets at startup. Only set this if you want to pin an exact value.
# GUNICORN_WORKERS=

# Redis connect/read timeout in seconds. Defaults to 0.25 (Redis runs on the
# same Docker network as the app). Raise this only if Redis is ever moved
# to a separate host/region with real network latency between them.
# REDIS_SOCKET_CONNECT_TIMEOUT=0.25
# REDIS_SOCKET_TIMEOUT=0.25

# --- Uploaded message attachments -------------------------------------
# Origin written into the links stored on messages. Leave blank to build them
# from the incoming request (fine for a single-host setup). Set it to the real
# site origin in production: WhatsApp Cloud API fetches these links from the
# public internet, so anything it cannot reach will fail to send.
MEDIA_PUBLIC_BASE_URL=
# Largest single attachment accepted, in bytes. Keep at or below nginx's
# client_max_body_size (20M by default).
MEDIA_ASSET_MAX_UPLOAD_BYTES=20971520


# =========================================================================
# PHASE 3 -- customer safety, data protection and operations
# =========================================================================

# --- Email (REQUIRED in production) --------------------------------------
# Production refuses to start on the development console backend. Without a
# real mail backend there is no password recovery: a customer who forgets
# their password has no way back into their account, and the application
# would report success while printing the reset link to a container log.
#
# Set the dummy backend explicitly if you are knowingly accepting that no
# mail is sent (staging, say) -- production will then start, and
# `manage.py check_production` reports it as a warning rather than passing.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

# The public URL of the application. Password-reset links, unsubscribe links
# and click-to-chat links are all built from it, so a wrong value means mail
# nobody can act on. Production refuses to start on localhost.
FRONTEND_URL=https://your-domain.com

# --- Password reset ------------------------------------------------------
# How long a reset link stays usable, in seconds. Django's own default is
# three days, which for a link that is a full account takeover for anybody who
# reads the mailbox is far too generous. One hour.
PASSWORD_RESET_TIMEOUT=3600

# Reset emails per *address* per window. The request-rate throttle counts per
# client address, which does nothing about somebody rotating addresses to fill
# one person's inbox -- this counts against the mailbox instead.
PASSWORD_RESET_MAX_PER_EMAIL=5
PASSWORD_RESET_EMAIL_WINDOW_SECONDS=3600

# --- Support contact -----------------------------------------------------
# Where customers are told to go when something is wrong. A reseller's
# customers see the reseller's address instead where one is set on their
# branding, so this is the platform-wide fallback.
SUPPORT_EMAIL=
SUPPORT_URL=

# --- Build identity ------------------------------------------------------
# Reported by /health/live/, /health/ready/ and the support diagnostics view,
# so a running container can be tied to a commit during an incident.
# APP_BUILD is expected to be a short commit sha stamped in at image build
# time (docker compose build --build-arg APP_BUILD=$(git rev-parse --short HEAD)).
APP_VERSION=1.0.0
APP_BUILD=
APP_ENVIRONMENT=production

# --- Legal documents -----------------------------------------------------
# Until all four are set, /terms, /privacy and /dpa are served with a visible
# "Draft -- not legally reviewed" banner and render [TO BE COMPLETED] where a
# value is missing. That is deliberate: a Terms of Service with a blank where
# the company name should be reads as finished when it is not.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=

# Bump the version when the wording changes. A new version makes every prior
# acceptance stale, so customers are asked to accept again and the record says
# which wording each of them agreed to. Never change the text without this.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
DPA_VERSION=1.0

# --- Error monitoring ----------------------------------------------------
# Optional. Unset (the default) means unhandled exceptions are visible only in
# container logs. When set, payloads are scrubbed before leaving the server:
# credentials removed by key name, message bodies and email addresses removed,
# phone numbers masked. See backend/core/monitoring.py.
SENTRY_DSN=
# Performance traces sample real request URLs and database queries, which is a
# second and quieter data-export path. Off by default.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Log hygiene ---------------------------------------------------------
# Mask phone numbers in log output (+91******3210). On by default in
# production, where logs are shipped and searched by more people than the
# database is; off in development, where the full number is usually the thing
# being debugged.
LOG_MASK_PHONE_NUMBERS=true

# --- Backups -------------------------------------------------------------
# Used by scripts/backup_postgres.sh and scripts/restore_postgres.sh.
#
# BACKUP_PASSPHRASE encrypts each dump with AES-256. A dump contains every
# phone number, message and encrypted provider credential in the deployment,
# and is about to be copied somewhere else -- leave this unset only if you
# have accepted that. KEEP OLD PASSPHRASES: rotating it does not re-encrypt
# existing archives, and without the old one they cannot be restored.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=

# WHERE THE BACKUP GOES. This is the setting that turns a second copy on the
# same disk into an actual backup: everything above survives a dropped table,
# only this survives losing the machine.
#
#   s3://bucket/prefix    uses the AWS CLI. Credentials come from the
#                         environment, an instance role, or ~/.aws -- never
#                         from this file and never on a command line.
#   rclone:remote:path    uses rclone, for B2, GCS, Azure, SFTP and the rest.
#
# A configured destination that FAILS to upload fails the whole backup run,
# loudly and with a non-zero exit. There is no silent fallback to local-only.
BACKUP_REMOTE_TARGET=

# For a destination neither of the above covers. `{src}` and `{name}` are
# substituted and the result is run verbatim.
#   BACKUP_UPLOAD_COMMAND=scp {src} backups@offsite:/vault/{name}
BACKUP_UPLOAD_COMMAND=

# The counterpart to BACKUP_UPLOAD_COMMAND, used by
# scripts/verify_offhost_backup.sh to fetch an archive back. `{name}` and
# `{dest}` are substituted.
#
# **Required whenever BACKUP_UPLOAD_COMMAND is set.** A destination this
# deployment can write to but cannot read back is a destination nobody can
# restore from, and the drill refuses to run without it rather than reporting
# a pass it did not earn. s3:// and rclone: targets need nothing here -- the
# drill knows how to read those back on its own.
#   BACKUP_DOWNLOAD_COMMAND=scp backups@offsite:/vault/{name} {dest}
BACKUP_DOWNLOAD_COMMAND=

# Never prune below this many local archives, however old they are. Under
# pure age-based retention, a deployment whose backups have been failing for
# three weeks deletes its last good one on the day somebody needs it.
BACKUP_MIN_KEEP=3

# Prune the remote too (rclone destinations only). Unset means never -- a
# lifecycle rule on the bucket is usually the better tool.
BACKUP_REMOTE_RETENTION_DAYS=

# Run when a backup fails, with the reason on stdin. A backup system whose
# failures are silent is not a backup system, it is a cron job that used to
# work.
#   BACKUP_ALERT_COMMAND=mail -s "SendStack backup failed" ops@example.com
BACKUP_ALERT_COMMAND=

# How old the last successful backup may be before `check_production` FAILs.
# A daily job plus slack.
BACKUP_MAX_AGE_HOURS=36

# How old the last recorded restore test may be before it WARNs.
RESTORE_TEST_MAX_AGE_DAYS=30

# How old the last **off-host** restore drill may be before it WARNs.
#
# A different and stronger claim than the line above. A local restore test
# proves the archive on this disk is a good archive; it says nothing about
# whether the object in the bucket is complete, readable with the credentials
# a rebuilt host would have, or in a storage tier that can be streamed. Every
# one of those failures passes an upload check and a local restore, and is
# discovered on the day the host is gone.
#
# Run by scripts/verify_offhost_backup.sh; reported by `check_production`.
OFFSITE_RESTORE_TEST_MAX_AGE_DAYS=30

# Legacy honour-system marker: the date of the last restore test, typed by
# hand. Superseded by the RESTORE_TEST rows that scripts/restore_postgres.sh
# now writes automatically, and only consulted when there are none.
BACKUP_VERIFIED_AT=

# Set to 1 if backups leave the host by some means this script does not know
# about. It silences the reminder AND stops `check_production` failing on
# "the last backup never left this host" -- so only set it if that is true.
BACKUP_OFFSITE_ACKNOWLEDGED=


# --- Commercial rollout ---------------------------------------------------
# Three independent switches. The defaults are the conservative ones: an
# existing deployment upgrading to this release gets no public signup page and
# no payment buttons until it asks for them.

# Whether strangers may create their own workspace at /signup.
SELF_SERVICE_SIGNUP_ENABLED=false

# Which tenant self-service workspaces hang off, by slug. Blank means the
# platform tenant. Set it to a reseller's slug where the public website is
# theirs. A customer tenant is refused: a customer under a customer would put
# one customer's data inside another's subtree.
SELF_SERVICE_SIGNUP_PARENT_SLUG=

# Whether a signup starts a free trial. Also governed by BILLING_TRIAL_PLAN
# below -- with no trial plan configured, trials are unavailable however this
# is set, and signup says so rather than falling through to "no plan" (which
# in this codebase means UNLIMITED).
TRIALS_ENABLED=true

# The platform-owned plan a trial runs on, by name. `manage.py seed_plans`
# writes a starting set including one called "Trial".
BILLING_TRIAL_PLAN=

# How long a trial runs. THE ONLY PLACE THIS NUMBER IS DECIDED -- the signup
# page and the billing page both ask the API for it.
BILLING_TRIAL_DAYS=14

# Days before the end that the one reminder goes out. 0 silences it.
BILLING_TRIAL_REMINDER_DAYS=3

# ISO 4217 code this deployment prices in. Plan.currency overrides it per plan.
BILLING_CURRENCY=INR


# --- Payments -------------------------------------------------------------
# Off unless BOTH switched on AND configured. PAYMENTS_ENABLED on its own
# does nothing: an unconfigured provider returns "payments unavailable" and
# `check_production` FAILs. It never produces a fake success.
PAYMENTS_ENABLED=false

# "razorpay" is implemented. "manual" is the explicit no-gateway mode, in
# which plans are assigned by an operator and no checkout is ever offered.
PAYMENT_PROVIDER=manual

# Razorpay credentials. The key id is public -- it is handed to the browser to
# open the checkout. The other two never leave the server, are never logged,
# and are never serialised into any response.
#
# Use TEST keys until you have run a real payment through end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# How long a raw webhook payload is kept, so a disputed activation can be
# reconstructed. It is a third party's data about a customer's payment and
# nothing needs it after the dispute window.
BILLING_WEBHOOK_PAYLOAD_RETENTION_DAYS=90


# --- The durable scheduler ------------------------------------------------
# Scheduled campaigns live in PostgreSQL, not in Redis. See docs/SCHEDULING.md.

# How often the poller asks for work that has come due, and therefore the
# scheduling precision this system offers: a job fires between its scheduled
# time and one interval later. Late, never early. Say "within a minute" to a
# customer, not "at 9:00:00".
SCHEDULER_POLL_INTERVAL_SECONDS=60

# How long a worker's claim on a job is honoured before it is treated as
# abandoned and returned to the queue. This is what makes a redeploy in the
# middle of a campaign a delay rather than a lost campaign.
SCHEDULER_LEASE_SECONDS=900

# Most jobs one tick will claim. A ceiling on the damage a backlog does to one
# tick, not a throughput limit.
SCHEDULER_BATCH_SIZE=100

# Hourly sweep that records expired trials and sends the notices. NOTE: this
# is bookkeeping only -- an expired trial loses access from its date whether
# or not this ever runs. See docs/BILLING.md.
TRIAL_SWEEP_INTERVAL_SECONDS=3600


# --- Data retention --------------------------------------------------------
# What the daily retention sweep is allowed to delete, and after how long.
# See docs/DATA_RETENTION.md, which this implements.
#
# Every value is in DAYS and 0 DISABLES that rule entirely -- the same
# "0 means unlimited" convention the plan ceilings use.
#
# These cover operational exhaust only. Customer business data, consent
# evidence, audit events, the credit ledger and financial records have no rule
# and are never pruned by the application.

# Raw provider webhook bodies. Kept only long enough that a provider's own
# retry still finds the row and is recognised as a duplicate; providers retry
# over hours, so a month is generous. This is usually the largest table in the
# deployment -- a webhook arrives per status transition, so it grows at roughly
# three rows per outbound message.
RETENTION_WEBHOOK_EVENT_DAYS=30

# Scheduled jobs that already ran or were cancelled. FAILED jobs are NOT
# covered: a failed scheduled job is exactly what an operator goes looking for
# weeks later when a customer asks why their campaign never went out.
RETENTION_SCHEDULED_JOB_DAYS=30

# The number-to-button lookup for a question sent as a numbered list. Inert
# once BUTTON_PROMPT_TIMEOUT_MINUTES has passed.
RETENTION_BUTTON_PROMPT_DAYS=7

# How often the sweep runs. It is slow background housekeeping, not a reaction
# to anything, so once a day is right.
RETENTION_SWEEP_INTERVAL_SECONDS=86400


# --- Lead tools: number filter and group grabber ---------------------------
#
# The number filter asks WhatsApp, through a QR-linked number, which numbers
# on a list are registered. It asks in batches with a pause between them,
# because a linked phone firing thousands of lookups back to back looks like
# the scraping WhatsApp bans numbers for. See docs/LEAD_TOOLS.md.

# Most numbers one check may cover. Larger lists are refused, not queued.
LEADTOOLS_NUMBER_CHECK_MAX_NUMBERS=10000
# Numbers asked per worker batch, and the pause between batches.
LEADTOOLS_NUMBER_CHECK_BATCH_SIZE=100
LEADTOOLS_NUMBER_CHECK_PAUSE_SECONDS=1.5
# WhatsApp groups one grab may read at once.
LEADTOOLS_GROUP_GRAB_MAX_GROUPS=25

# --- Outbound URL policy (SSRF protection) ---------------------------------
# The AI and Voice agents let a tenant type the URL this server then makes an
# authenticated request to, so a customer can bring their own OpenAI-compatible
# endpoint. Unchecked, that lets a tenant admin make this server read the cloud
# metadata service or scan the internal Docker network and have the response
# reported back to them. See backend/core/outbound_urls.py.
#
# Private, loopback and link-local addresses are refused by default. That also
# refuses the documented self-hosted case (Ollama on http://localhost:11434/v1),
# so an operator running one names its host here. Deliberately deployment
# configuration: a tenant must not be able to grant themselves access to this
# deployment's own network.
# OUTBOUND_URL_ALLOWED_INTERNAL_HOSTS=ollama,localhost

# The blunt version, for a single-tenant install on a private network with no
# untrusted tenants. Turning it on removes the protection above entirely.
# OUTBOUND_URL_ALLOW_PRIVATE=false


# --- Worker sizing and resource limits -------------------------------------
# Container memory limits, and the worker counts derived from them.
#
# Sized against a measurement, not a guess: a booted Django process on this
# codebase is ~80 MB resident. backend/gunicorn.conf.py reads MEM_LIMIT_BACKEND
# from the container's own cgroup and derives its worker count from it, so
# raising the limit raises the worker count automatically and the two cannot
# drift apart. The web tier settles at ~410 MiB with these values.
#
# Do not raise a limit without the memory to back it: an unbounded container
# takes the whole host down with it, which on this stack means PostgreSQL dies
# because a Celery worker was importing a large CSV.
# MEM_LIMIT_POSTGRES=1g
# MEM_LIMIT_BACKEND=1g
# MEM_LIMIT_WORKER=1g
# MEM_LIMIT_BEAT=256m
# MEM_LIMIT_REDIS=256m
# MEM_LIMIT_NGINX=128m
# MEM_LIMIT_QR_BRIDGE=512m
# Certbot sleeps for twelve hours at a time and wakes up to do nothing.
# MEM_LIMIT_CERTBOT=128m

# Celery worker processes. Set explicitly rather than left to Celery's default
# of one per CPU: on a 24-core host that default is 24 Django processes at
# ~80 MB each, for work that is almost entirely waiting on a provider's HTTP
# response. Raise this and MEM_LIMIT_WORKER together.
# CELERY_CONCURRENCY=4

# Pin the gunicorn worker count instead of deriving it from memory and CPU.
# Only set this if you have measured your own box.
# GUNICORN_WORKERS=


# --- Signup rate limits ---------------------------------------------------
# Creating an account is rarer than signing in and far more expensive, so it
# gets its own budget rather than sharing the login one.
# THROTTLE_RATE_SIGNUP=5/min
# THROTTLE_RATE_PRICING=120/min

# --- Data export ---------------------------------------------------------
# A whole-workspace export reads every table the tenant owns. At the ordinary
# user rate one account could build a hundred a minute.
# THROTTLE_RATE_EXPORT=5/hour

# --- Coupons -------------------------------------------------------------
# A coupon box is a code oracle if it is not rate limited: given enough
# attempts, somebody walks the keyspace until a discount comes back. Every
# refusal is worded identically whatever the reason, so each guess is
# uninformative; this makes guessing slow as well. Generous enough that a
# customer mistyping a code three times never notices.
# THROTTLE_RATE_COUPON=20/min

# --- Support requests ----------------------------------------------------
# One support request is a person typing a paragraph. A hundred is a script
# or a mistake, and both fill an inbox somebody empties by hand.
# THROTTLE_RATE_SUPPORT=10/hour

# --- Load testing --------------------------------------------------------
# NOT for production. When running scripts/loadtest.py against a staging
# stack, raise THROTTLE_RATE_USER and THROTTLE_RATE_AUTH there so the test
# measures the application rather than the rate limiter -- a saturation run at
# production rates reports 85% 429s and tells you nothing about capacity.
# Run it once at production rates as well, to confirm the limiter holds.

# =============================================================================
# PUBLIC DEVELOPER API  (apps/publicapi)
# =============================================================================
# The API external software calls with an API key, mounted at /api/public/v1/.
# Nothing here needs setting for the API to work -- every value has a default.

# --- Rate limits -------------------------------------------------------------
# The ceilings a key falls back to when it sets none of its own. NOTE the
# convention: 0 on an *API key* means "use these defaults", not "unlimited".
# A forgotten rate limit must not become no rate limit.
#
# The message ceiling is lower than the request ceiling on purpose: a request
# is cheap, and a message occupies a Celery worker and a real WhatsApp
# connection for seconds.
PUBLIC_API_DEFAULT_REQUESTS_PER_MINUTE=120
PUBLIC_API_DEFAULT_MESSAGES_PER_MINUTE=60
PUBLIC_API_DEFAULT_CAMPAIGNS_PER_DAY=50

# --- The address customers are told to call ----------------------------------
# Printed in Developer -> API Overview, in the HTML reference at
# /api/public/v1/docs, in the OpenAPI document's `servers` block, in the
# exported Postman environment and in every generated curl example.
#
# Deliberately NOT the same setting as BACKEND_PUBLIC_URL. That one is the
# address *we* are reachable at from inside the deployment -- under
# docker-compose it is http://backend:8000, a name that resolves only on the
# Docker network. Printing it on the screen whose whole job is to answer "where
# do I take the URL from?" hands every customer an address that cannot work.
#
# LEAVE THIS EMPTY unless the API is served on a different hostname from the
# dashboard. Empty does not mean broken: the URL is then rebuilt from the
# request, so customers see the address their own browser just reached you on,
# which is by construction one that works from where they are. Set it when you
# put api.example.com in front of app.example.com, because then the request
# cannot tell us.
PUBLIC_API_BASE_URL=

# --- HTTPS -------------------------------------------------------------------
# Both default to "required unless DEBUG", so production enforces HTTPS without
# an operator having to know these exist. Set either to false ONLY for local
# development: the first sends every API key in cleartext, and the second sends
# message content and phone numbers the same way.
# PUBLIC_API_REQUIRE_HTTPS=true
# PUBLIC_API_REQUIRE_HTTPS_WEBHOOKS=true

# --- Webhooks ----------------------------------------------------------------
# A kill switch for outbound webhook delivery. Emission becomes a no-op and
# nothing else about the API changes -- useful when egress is down and the
# delivery queue would otherwise fill with doomed retries.
PUBLIC_API_WEBHOOKS_ENABLED=true
# How long we wait for a receiver to acknowledge. Deliberately short: a
# receiver is meant to answer fast and process asynchronously, and one that
# takes longer will eventually take a worker down with it.
PUBLIC_API_WEBHOOK_TIMEOUT_SECONDS=10
# How often stranded deliveries are re-queued. This is what makes delivery
# at-least-once rather than best-effort; see apps/publicapi/tasks.py.
WEBHOOK_SWEEP_INTERVAL_SECONDS=60

# --- Log retention -----------------------------------------------------------
# The two tables that grow with API traffic rather than with customers.
# 0 turns a rule off entirely, the same convention the other retention
# settings use. Neither table holds request or webhook *bodies*.
PUBLIC_API_REQUEST_LOG_RETENTION_DAYS=30
PUBLIC_API_WEBHOOK_LOG_RETENTION_DAYS=30
PUBLIC_API_PRUNE_INTERVAL_SECONDS=21600

# ---------------------------------------------------------------------------
# Chatbot
# ---------------------------------------------------------------------------
#
# The chatbot has no credentials of its own: the model, key and provider are the
# AI agent's (AI_* / OPENAI_* above), and the number is the WhatsApp account's.
# What is configurable here is only how long its own bookkeeping is kept.

# How long the per-message debug trail is kept. Roughly a dozen rows per inbound
# message, and it answers "why did that happen?" -- which nobody asks about last
# quarter. 0 keeps it forever, which is only sensible on a deployment small
# enough that somebody is watching the table size.
CHATBOT_EVENT_RETENTION_DAYS=30

# How often celery-beat closes conversations nobody has touched, and prunes the
# trail. Both are housekeeping; neither touches a customer's messages.
CHATBOT_SESSION_SWEEP_INTERVAL_SECONDS=900
CHATBOT_EVENT_PRUNE_INTERVAL_SECONDS=86400
